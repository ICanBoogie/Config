{
  "name": "icanboogie/config",
  "type": "library",
  "description": "Synthesizes low-level configurations.",
  "keywords": [
    "config"
  ],
  "homepage": "https://icanboogie.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/ICanBoogie/Config/issues",
    "source": "https://github.com/ICanBoogie/Config"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "icanboogie/common": "^6.0",
    "icanboogie/storage": "^6.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.4"
  },
  "autoload": {
    "psr-4": {
      "ICanBoogie\\": "lib"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\ICanBoogie\\": "tests"
    }
  }
}
